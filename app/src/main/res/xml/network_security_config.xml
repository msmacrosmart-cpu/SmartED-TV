<?xml version="1.0" encoding="utf-8"?>
<!-- Muitas listas IPTV públicas usam HTTP puro; permitimos cleartext
     globalmente mas mantemos a configuração explícita para auditoria. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
